# MCE Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER SETTINGS
# =============================================================================
MCE_HOST=0.0.0.0
MCE_PORT=8000
MCE_LOG_LEVEL=INFO
MCE_DEBUG=false

# =============================================================================
# COMPILER SETTINGS
# =============================================================================
MCE_COMPILE_ON_STARTUP=true
MCE_COMPILED_OUTPUT_DIR=./compiled
MCE_SWAGGER_CONFIG_FILE=./config/swaggers.yaml

# LLM enhancement (optional — requires litellm package: pip install mce[llm])
# MCE_LLM_MODEL uses LiteLLM naming convention — examples:
#   OpenAI:      openai/gpt-4o
#   Anthropic:   anthropic/claude-3-5-sonnet-20241022
#   Gemini:      gemini/gemini-2.0-flash
#   OpenRouter:  openrouter/mistralai/mistral-7b-instruct
MCE_LLM_ENHANCE=false
MCE_LLM_API_KEY=
MCE_LLM_MODEL=gemini/gemini-2.0-flash

# =============================================================================
# EXECUTOR SETTINGS
# =============================================================================
MCE_LINT_ENABLED=false
MCE_DOCKER_IMAGE=mce-sandbox:latest
MCE_EXECUTION_TIMEOUT_SECONDS=30
MCE_MAX_OUTPUT_SIZE_BYTES=1048576
MCE_NETWORK_MODE=mce_network

# =============================================================================
# CACHE SETTINGS (legacy — kept for backwards compatibility)
# =============================================================================
MCE_CACHE_ENABLED=true
MCE_CACHE_TTL_SECONDS=3600
MCE_CACHE_MAX_ENTRIES=500
MCE_CACHE_DB_PATH=./data/cache.db

# =============================================================================
# REUSABLE FUNCTION LIBRARY
# =============================================================================
# Maximum number of functions in library before auto-pruning least-used
MCE_REUSABLE_FUNCTION_MAX_COUNT=50
# Days of inactivity before function is auto-deleted
MCE_REUSABLE_FUNCTION_TTL_DAYS=30

# =============================================================================
# SECURITY
# =============================================================================
MCE_MAX_CODE_SIZE_BYTES=65536
# Comma-separated allowed API domains (empty = allow all)
# MCE_ALLOWED_DOMAINS=api.weather.example.com,api.hotel.example.com

# =============================================================================
# API SERVER CREDENTIALS
# =============================================================================

# Single-instance server format:
# MCE_{SERVER_NAME_UPPER}_BASE_URL
# MCE_{SERVER_NAME_UPPER}_AUTH (for JWT auth)

# Weather API (single instance)
MCE_WEATHER_BASE_URL=https://api.weather.example.com/v1
MCE_WEATHER_AUTH=Authorization: Bearer your-weather-api-key-here

# =============================================================================
# MULTI-INSTANCE SERVER CREDENTIALS (e.g., Mirth across environments)
# Format: MCE_{SERVER_NAME_UPPER}_{INSTANCE_NAME_UPPER}_{FIELD}
# =============================================================================

# Mirth - Shared config across all instances
MCE_MIRTH_SESSION_COOKIE_NAME=JSESSIONID
MCE_MIRTH_SESSION_ENDPOINT=/users/login

# Mirth Production Instance
MCE_MIRTH_PROD_BASE_URL=https://mirth-prod.example.com/api
MCE_MIRTH_PROD_SESSION_USERNAME=your-prod-username
MCE_MIRTH_PROD_SESSION_PASSWORD=your-prod-password
MCE_MIRTH_PROD_IS_READ_ONLY=true

# Mirth Staging Instance
MCE_MIRTH_STAGING_BASE_URL=https://mirth-staging.example.com/api
MCE_MIRTH_STAGING_SESSION_USERNAME=your-staging-username
MCE_MIRTH_STAGING_SESSION_PASSWORD=your-staging-password
MCE_MIRTH_STAGING_IS_READ_ONLY=false

# Mirth Dev Instance
MCE_MIRTH_DEV_BASE_URL=https://mirth-dev.example.com/api
MCE_MIRTH_DEV_SESSION_USERNAME=your-dev-username
MCE_MIRTH_DEV_SESSION_PASSWORD=your-dev-password
MCE_MIRTH_DEV_IS_READ_ONLY=false
