servers:
  # Mirth API with multiple deployment instances
  # All instances share the same API surface defined by swagger_url
  - swagger_url: "https://mirth-prod.example.com/api/swagger.json"
    auth_type: "session"
    session_cookie_name: "JSESSIONID"
    session_endpoint: "/users/login"  # Path appended to each instance's base_url for authentication

    # Define instances - each represents a different deployment
    instances:
      - instance_name: "prod"
        base_url: "https://mirth-prod.example.com/api"
        session_credentials:
          username: "${MIRTH_PROD_USERNAME}"
          password: "${MIRTH_PROD_PASSWORD}"
        is_read_only: true        # Prevent destructive operations on production

      - instance_name: "staging"
        base_url: "https://mirth-staging.example.com/api"
        session_credentials:
          username: "${MIRTH_STAGING_USERNAME}"
          password: "${MIRTH_STAGING_PASSWORD}"
        is_read_only: false       # Allow modifications in staging

      - instance_name: "dev"
        base_url: "https://mirth-dev.example.com/api"
        session_credentials:
          username: "${MIRTH_DEV_USERNAME}"
          password: "${MIRTH_DEV_PASSWORD}"
        is_read_only: false       # Allow modifications in dev
